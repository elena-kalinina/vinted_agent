# Vinted API Authentication
# Get these from browser DevTools (Network tab) when logged into Vinted
# Session cookie: Look for "_vinted_fr_session" cookie value
VINTED_SESSION_COOKIE=your_vinted_session_cookie_here

# Bearer token: Look for "Authorization: Bearer ..." header in API requests
VINTED_BEARER_TOKEN=your_vinted_bearer_token_here

# Google Gemini API Key
# Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: Google API Key (used by langchain-google-genai)
GOOGLE_API_KEY=your_google_api_key_here
